# 邮箱（IMAP + SMTP 方案，替代 Gmail API）
# MAIL_AUTH_CODE 是邮箱设置里生成的「授权码」，不是登录密码
MAIL_ADDRESS=
MAIL_AUTH_CODE=
IMAP_HOST=imap.qq.com
IMAP_PORT=993
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

DATABASE_URL=
DEEPSEEK_API_KEY=
CLASSIFIER_MODEL=deepseek:deepseek-flash
AGENT_MODEL=deepseek:deepseek-v4-pro
POLL_INTERVAL_SECONDS=30
PIPELINE_DRY_RUN=0
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
PYDANTIC_AI_NO_BANNER=1
